{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(./node_modules/.bin/tsc *)",
      "Bash(./node_modules/.bin/eslint *)",
      "Bash(pnpm exec tsc *)",
      "Bash(pnpm exec eslint *)",
      "Bash(pnpm tsc *)"
    ],
    "deny": [
      "Skill(run)",
      "Bash(pnpm dev*)",
      "Bash(pnpm start*)",
      "Bash(next dev*)",
      "Bash(next start*)"
    ],
    "ask": [
      "Bash(git commit*)"
    ]
  }
}
